{
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|manifest\\.json|sw\\.js|robots\\.txt|sitemap\\.xml|og-image\\.svg|404\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
